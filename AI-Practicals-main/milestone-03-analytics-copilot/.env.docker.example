# Copy to .env before: docker compose up --build
# Bedrock + optional S3/LangFuse still use your AWS / Langfuse credentials.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
BEDROCK_EMBED_MODEL=amazon.nova-2-multimodal-embeddings-v1:0
BEDROCK_EMBED_DIMENSION=1024
BEDROCK_LLM_MODEL=us.amazon.nova-2-lite-v1:0

OPENSEARCH_INDEX=rag-index

# Docker Compose overrides (also set in docker-compose.yml for api service)
OPENSEARCH_MODE=local
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false

POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass
POSTGRES_DB=milestone_3

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

API_PORT=8000
