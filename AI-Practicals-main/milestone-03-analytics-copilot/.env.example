# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
BEDROCK_EMBED_MODEL=amazon.nova-2-multimodal-embeddings-v1:0
BEDROCK_EMBED_DIMENSION=1024
BEDROCK_LLM_MODEL=us.amazon.nova-2-lite-v1:0

# OpenSearch — aws (Serverless) or local (Docker)
OPENSEARCH_MODE=aws
OPENSEARCH_COLLECTION_NAME=rag-serverless
OPENSEARCH_INDEX=rag-index
# Local Docker only:
# OPENSEARCH_MODE=local
# OPENSEARCH_HOST=opensearch
# OPENSEARCH_PORT=9200
# OPENSEARCH_USE_SSL=false

# PostgreSQL (SQL agent) — use DATABASE_URL or POSTGRES_URL
DATABASE_URL=postgresql://user:pass@localhost:5432/rag_analytics
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rag_analytics
# POSTGRES_USER=rag_user
# POSTGRES_PASSWORD=rag_pass

# Agent limits
AGENT_MAX_STEPS=8
AGENT_MAX_SQL_ROWS=100

# LangFuse tracing (https://cloud.langfuse.com)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
